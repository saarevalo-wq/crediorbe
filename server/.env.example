# Used for local testing — in production these are set as environment
# variables in the Render dashboard instead (see README.md).

GOOGLE_CLIENT_ID=811686460443-86r94592ibfv48bs709jpopf0jo242kf.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REEMPLAZA_CON_TU_CLIENT_SECRET
# Must exactly match an Authorized redirect URI on the OAuth client.
GOOGLE_REDIRECT_URI=https://REEMPLAZA-CON-TU-URL-DE-RENDER/auth/google/callback

# Upstash Redis (free) — console.upstash.com → Create database → REST API section.
UPSTASH_REDIS_REST_URL=https://REEMPLAZA.upstash.io
UPSTASH_REDIS_REST_TOKEN=REEMPLAZA_CON_TU_TOKEN

VAPID_PUBLIC_KEY=BD7UJu-wBpnChtgnm8VyGTjXAzzhSIrEdkbthWDjwz7Japj8jE2AqSVpopGP_lUvN0Jt0vcvVA7q5vwGtNgebWg
VAPID_PRIVATE_KEY=REEMPLAZA_CON_TU_VAPID_PRIVATE_KEY
VAPID_CONTACT_EMAIL=mailto:tu-correo@ejemplo.com

# Protects GET /poll from random internet requests.
POLL_SECRET=REEMPLAZA_CON_UN_VALOR_ALEATORIO

# console.anthropic.com → API Keys → Create Key. Sin esto, el clasificador
# usa reglas por palabras clave (no lee adjuntos) como respaldo.
ANTHROPIC_API_KEY=REEMPLAZA_CON_TU_LLAVE_sk-ant-...
# Opcional — modelo a usar (por defecto claude-sonnet-4-5).
# ANTHROPIC_MODEL=claude-sonnet-4-5

PORT=8788

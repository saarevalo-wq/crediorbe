# Google Cloud Console → same OAuth client as the frontend, but you also need
# the CLIENT SECRET here (server-side only — never put this in the frontend).
GOOGLE_CLIENT_ID=REEMPLAZA_CON_TU_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REEMPLAZA_CON_TU_CLIENT_SECRET
# Must exactly match an authorized redirect URI on the OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:8788/auth/google/callback

# Generate with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:tu-correo@ejemplo.com

# How often to poll Gmail for new judicial emails (cron syntax, default: every 15 min)
POLL_CRON=*/15 * * * *

PORT=8788
